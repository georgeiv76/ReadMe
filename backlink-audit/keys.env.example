# Copy this file to keys.env (same directory) and fill in real values.
# keys.env is git-ignored - it must NEVER be committed, this repo is public.
#
# The MCP server reads this file automatically at startup if present.
# A real OS/shell environment variable with the same name always wins
# over this file, so this is purely a fallback for desktop-GUI-launched
# processes that do not inherit your shell's exported variables.

AHREFS_API_KEY=
BING_WEBMASTER_API_KEY=
OPR_API_KEY=
